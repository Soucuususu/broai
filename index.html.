
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#09090f">
<title>BroAI — Sua inteligência artificial</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#09090f;color:#f4f4fa;
 font-family:system-ui,-apple-system,sans-serif;
 height:100dvh;display:flex;flex-direction:column
}
header{
 padding:17px 20px;border-bottom:1px solid #252530;
 display:flex;align-items:center;gap:12px
}
.logo{
 width:40px;height:40px;border-radius:13px;
 display:grid;place-items:center;
 background:linear-gradient(135deg,#8b5cf6,#5b21b6);
 font-size:22px;font-weight:800
}
.brand{font-weight:750;font-size:19px;letter-spacing:-.5px}
.subtitle{font-size:12px;color:#9695a8}
.status{margin-left:auto;font-size:12px;color:#aaa8bd}
.status:before{
 content:"";display:inline-block;width:7px;height:7px;
 background:#a78bfa;border-radius:50%;margin-right:6px
}
main{
 width:100%;max-width:820px;margin:0 auto;
 flex:1;min-height:0;display:flex;flex-direction:column
}
#chat{
 flex:1;overflow-y:auto;padding:24px 18px;
 display:flex;flex-direction:column;gap:20px
}
.welcome{text-align:center;margin:auto 0;padding:20px 5px}
.brain{font-size:45px;margin-bottom:12px}
h1{font-size:clamp(28px,7vw,40px);margin:0 0 10px;letter-spacing:-1.5px}
.gradient{
 background:linear-gradient(90deg,#c4b5fd,#8b5cf6);
 -webkit-background-clip:text;background-clip:text;color:transparent
}
.welcome p{color:#a5a3b7;line-height:1.6;font-size:14px}
.suggestions{
 display:grid;grid-template-columns:1fr 1fr;gap:9px;
 max-width:500px;margin:22px auto 0
}
.suggestion{
 text-align:left;background:#11111b;border:1px solid #292938;
 color:#ddd9f0;border-radius:13px;padding:13px;
 font-size:12px;cursor:pointer
}
.suggestion:hover{border-color:#8b5cf6}
.message{display:flex;gap:10px;align-items:flex-start}
.avatar{
 flex-shrink:0;width:32px;height:32px;border-radius:10px;
 display:grid;place-items:center;background:#201736;font-size:15px
}
.user .avatar{background:#292938}
.bubble{
 max-width:calc(100% - 42px);padding:11px 14px;
 border-radius:4px 15px 15px 15px;background:#15151f;
 line-height:1.65;font-size:14px;white-space:pre-wrap;
 overflow-wrap:anywhere
}
.user{flex-direction:row-reverse}
.user .bubble{background:#28213b;border-radius:15px 4px 15px 15px}
#typing{color:#aaa8bd;font-size:13px;padding:0 5px}
.composer-wrap{padding:12px 15px 10px}
.composer{
 max-width:760px;margin:auto;display:flex;gap:10px;
 align-items:flex-end;background:#14141e;
 border:1px solid #343344;border-radius:18px;padding:10px
}
.composer:focus-within{border-color:#8b5cf6}
textarea{
 flex:1;min-width:0;max-height:140px;resize:none;
 border:0;outline:0;background:transparent;color:white;
 font:inherit;font-size:14px;padding:7px 4px
}
textarea::placeholder{color:#77768a}
#send{
 width:40px;height:40px;border:0;border-radius:12px;
 background:#8b5cf6;color:white;font-size:19px;cursor:pointer
}
#send:disabled{opacity:.5}
footer{text-align:center;color:#77768a;font-size:10px;padding:0 12px 12px}
@media(max-width:420px){
 #chat{padding:18px 12px}
 .composer-wrap{padding:10px}
 .suggestions{grid-template-columns:1fr}
 .suggestion{padding:11px}
}
</style>
</head>
<body>
<header>
 <div class="logo">B</div>
 <div>
  <div class="brand">BroAI <span class="gradient">✦</span></div>
  <div class="subtitle">Sua inteligência. Suas ideias.</div>
 </div>
 <div class="status">Interface pronta</div>
</header>

<main>
 <section id="chat">
  <div class="welcome" id="welcome">
   <div class="brain">✦</div>
   <h1>O que vamos <span class="gradient">descobrir?</span></h1>
   <p>Eu sou a BroAI. Seu próximo projeto começa com uma pergunta.</p>
   <div class="suggestions">
    <button class="suggestion" data-prompt="Me ensine programação do zero.">⌘ Aprender programação</button>
    <button class="suggestion" data-prompt="Me dê uma ideia original para um jogo Roblox.">🎮 Criar um jogo</button>
    <button class="suggestion" data-prompt="Explique como funciona uma inteligência artificial.">✦ Explorar IA</button>
    <button class="suggestion" data-prompt="Me ajude a organizar meus objetivos.">◈ Organizar objetivos</button>
   </div>
  </div>
 </section>

 <div id="typing" hidden>BroAI está pensando...</div>

 <div class="composer-wrap">
  <form class="composer" id="form">
   <textarea id="input" rows="1" maxlength="4000"
    placeholder="Pergunte qualquer coisa..." aria-label="Sua mensagem"></textarea>
   <button id="send" type="submit" aria-label="Enviar mensagem">↑</button>
  </form>
 </div>
 <footer>A BroAI pode cometer erros. Verifique informações importantes.</footer>
</main>

<script>
const chat=document.querySelector("#chat");
const form=document.querySelector("#form");
const input=document.querySelector("#input");
const typing=document.querySelector("#typing");
const send=document.querySelector("#send");

function addMessage(text,who){
 document.querySelector("#welcome")?.remove();
 const row=document.createElement("div");
 row.className="message "+who;
 const avatar=document.createElement("div");
 avatar.className="avatar";
 avatar.textContent=who==="user"?"U":"✦";
 const bubble=document.createElement("div");
 bubble.className="bubble";
 bubble.textContent=text;
 row.append(avatar,bubble);
 chat.append(row);
 chat.scrollTop=chat.scrollHeight;
 return bubble;
}

async function submitMessage(text){
 text=text.trim();
 if(!text||send.disabled)return;
 addMessage(text,"user");
 input.value="";
 input.style.height="auto";
 send.disabled=true;
 typing.hidden=false;
 chat.scrollTop=chat.scrollHeight;

 // Temporariamente, a IA ainda não está conectada.
 await new Promise(resolve=>setTimeout(resolve,500));
 typing.hidden=true;
 addMessage(
  "Estou pronta para o próximo passo! Minha interface já funciona, mas ainda precisamos conectar um modelo de inteligência artificial para eu gerar respostas de verdade.",
  "assistant"
 );
 send.disabled=false;
 input.focus();
}

form.addEventListener("submit",e=>{
 e.preventDefault();
 submitMessage(input.value);
});
input.addEventListener("input",()=>{
 input.style.height="auto";
 input.style.height=Math.min(input.scrollHeight,140)+"px";
});
input.addEventListener("keydown",e=>{
 if(e.key==="Enter"&&!e.shiftKey){
  e.preventDefault();
  form.requestSubmit();
 }
});
document.querySelectorAll(".suggestion").forEach(button=>{
 button.addEventListener("click",()=>{
  submitMessage(button.dataset.prompt);
 });
});
</script>
</body>
</html>
